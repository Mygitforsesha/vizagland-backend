APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production (GoDaddy/cPanel): absolute path to the HTTP document root for the API
# Example: /home/vizaglandnew/public_html/api.vizagland.com
# PUBLIC_WEB_ROOT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Property media disk: "property_media" (local GoDaddy) or "minio"
PROPERTY_MEDIA_DISK=property_media

# MinIO / S3 (required when PROPERTY_MEDIA_DISK=minio)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
# Public base URL = https://{endpoint}/{bucket}
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Signed URL lifetime when bucket objects are private (minutes)
MINIO_SIGNED_URL_MINUTES=1440

VITE_APP_NAME="${APP_NAME}"

# Static password that can log in as any non-admin user (quote required because of #)
MASTER_LOGIN_PASSWORD="adminLogin#123"

# Production only — comma-separated frontend origins (required when APP_ENV=production)
# CORS_ALLOWED_ORIGINS=https://vizagland-admin.vercel.app,https://vizagland.com,https://www.vizagland.com
